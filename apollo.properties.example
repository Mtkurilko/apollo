# Apollo Remote Server Configuration
# Copy this file to apollo.properties and fill in your own values.
# apollo.properties is git-ignored so credentials stay off the repo.

ssh.host=your.host.or.ip
ssh.user=your-username
ssh.port=22

# Prefer key-based auth: point at a private key and leave ssh.password empty.
ssh.key=~/.ssh/id_ed25519
ssh.password=

# Password to unlock the Apollo boot screen
apollo.password=change-me
